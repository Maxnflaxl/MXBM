# Build output -- NO compiled artifact is ever committed; everything is built.
/build/
/out/
*.o
*.obj
*.exe
*.cubin
*.ptx
*.fatbin

# Standalone nvcc-built probes under cuda/ (see cuda/README.md for the build lines).
# Listed by name because they have no extension and sit beside their sources.
/cuda/pipeline
/cuda/pipeline-*
/cuda/emit_shape_probe
/cuda/test_primitives
/benchmarks/nvml_energy
/build-probe/

# CUDA / HIP intermediates
*.i
*.ii
*.gpu
*.cudafe*

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Benchmark raw captures (keep summaries, not multi-GB traces)
/benchmarks/**/*.ncu-rep
/benchmarks/**/*.nsys-rep
/benchmarks/**/*.qdrep

# Orchestration scratch / ledger — never commit
/.superpowers/

# Internal working docs (research, planning, roadmap, legal notes) — not shipped publicly
/docs-internal/

# The working task list. The PUBLIC roadmap is the table in README.md; this one holds
# the undecided and the unflattering, so it stays local.
/TODO.md

# Phase-D2 exploratory spikes (CUDA comparison, etc.) — not part of the build
spike/
Testing/

# Live miner run logs -- these echo the authorized worker (wallet address).
# /logs/ is where --log puts its transcript when --logfile is not given.
*.log
mxbm-run.log
/logs/

# Local miner configs -- same reason as the logs above: these hold YOUR wallet
# address and pool credentials. Both formats are documented in docs/usage.md,
# and committed examples with placeholder addresses live in tests/fixtures/.
/user_config.json
/*.cfg

# Python bytecode
__pycache__/
*.pyc

# mclk_rung.sh raw captures: per-arm miner logs and telemetry, plus the run
# transcript. The findings go in docs/performance.md; the traces stay local.
.mclk/
.mclk.out
